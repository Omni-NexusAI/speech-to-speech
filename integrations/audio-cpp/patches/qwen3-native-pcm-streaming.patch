+std::optional<Qwen3GenerationTelemetry> qwen3_generation_telemetry(
+    const std::vector<engine::runtime::VoiceArtifact> & artifacts) {
+    for (const auto & artifact : artifacts) {
+        if (artifact.id != "qwen3_tts.generation") continue;
+        const auto frames = artifact.meta.find("generated_frames");
+        const auto cap = artifact.meta.find("generation_cap");
+        const auto termination = artifact.meta.find("termination");
+        const auto prompt_ms = artifact.meta.find("prompt_ms");
+        const auto prefill_ms = artifact.meta.find("prefill_ms");
+        const auto talker_ms = artifact.meta.find("talker_ms");
+        const auto decoder_ms = artifact.meta.find("decoder_ms");
+        if (frames == artifact.meta.end() || cap == artifact.meta.end() ||
+            termination == artifact.meta.end() || prompt_ms == artifact.meta.end() ||
+            prefill_ms == artifact.meta.end() || talker_ms == artifact.meta.end() ||
+            decoder_ms == artifact.meta.end()) return std::nullopt;
+        return Qwen3GenerationTelemetry{
+            frames->second, cap->second, termination->second, prompt_ms->second,
+            prefill_ms->second, talker_ms->second, decoder_ms->second};
+    }
+    return std::nullopt;
+}
