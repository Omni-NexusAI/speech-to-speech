+    const auto parse_block_frames = [&](const char * key, int64_t fallback) {
+        const auto value = runtime::parse_i64_option(request.options, {key});
+        const int64_t frames = value.value_or(fallback);
+        if (frames <= 0 || frames > 300) {
+            throw std::runtime_error(std::string(key) + " must be between 1 and 300 codec frames");
+        }
+        return frames;
+    };
+    const int64_t first_block_frames = parse_block_frames("qwen3_tts.stream_first_block_frames", 4);
+    const int64_t steady_block_frames = parse_block_frames("qwen3_tts.stream_steady_block_frames", 12);
