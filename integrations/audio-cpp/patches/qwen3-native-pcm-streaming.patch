+        text_tokenizer_,
+        *speech_encoder_,
+        *speaker_encoder_,
+        assets_->config.talker.max_position_embeddings);
+    const auto prompt_start = Clock::now();
+    const auto & voice_prompt = resolve_voice_prompt(*qwen_request.voice_clone, prompt_builder);
+    const double prompt_ms = engine::debug::elapsed_ms(prompt_start, Clock::now());
+    if (!voice_prompt.reference_codes.has_value()) {
+        throw std::runtime_error("Qwen3 native PCM streaming currently requires full ICL clone conditioning");
+    }
+    const auto prefill_start = Clock::now();
