+
+void Qwen3TTSSession::reset() {
+    streaming_result_.reset();
+    streaming_started_ = false;
+}
+
+void Qwen3TTSSession::start_stream(const runtime::TaskRequest & request) {
+    require_prepared("Qwen3 TTS start_stream");
+    if (task_.mode != runtime::RunMode::Streaming) {
+        throw std::runtime_error("Qwen3 TTS start_stream called for an offline session");
+    }
+    reset();
+    streaming_started_ = true;
+    try {
+        const auto decode_mode = streaming_decode_mode_from_request(request);
+        if (decode_mode == Qwen3RequestDecodeMode::OfflineFull) {
+            // The model weights and streaming-capable session stay resident,
+            // but this request uses the original complete offline algorithm.
+            // No stream event is emitted; finish_stream returns one master.
+            streaming_result_ = run_offline_request(request);
+            attach_decode_mode(*streaming_result_, "offline-full-decoder");
+            debug::timing_log_scalar("qwen3_tts.offline_full", 1.0);
+        } else {
+            streaming_result_ = run_streaming_base_request(request);
+            attach_decode_mode(*streaming_result_, "native-incremental-pcm");
+        }
+    } catch (...) {
+        // Validation, prompt construction, decoder, and callback failures all
+        // leave this session reusable; never expose a stale final result.
+        reset();
+        if (mem_saver_) {
+            (void) talker_step_->release_cached_step_graph();
+        }
+        throw;
+    }
+}
+
+std::optional<runtime::StreamEvent> Qwen3TTSSession::next_stream_event() {
+    // Events are delivered synchronously from the talker callback so the HTTP
+    // writer can flush each PCM block before the next autoregressive step.
+    return std::nullopt;
+}
+
+runtime::TaskResult Qwen3TTSSession::finish_stream() {
+    if (!streaming_started_ || !streaming_result_.has_value()) {
+        throw std::runtime_error("Qwen3 TTS streaming has not been started");
+    }
+    runtime::TaskResult result = std::move(*streaming_result_);
+    streaming_result_.reset();
+    streaming_started_ = false;
+    return result;
+}
