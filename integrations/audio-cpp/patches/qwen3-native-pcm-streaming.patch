+    if (codes.termination == Qwen3GenerationTermination::Eos) {
+        emit_pending();
+    } else {
+        pending.codes.clear();
+        pending.frames = 0;
+    }
+    if (mem_saver_) {
+        (void)talker_step_->release_cached_step_graph();
+    }
+    runtime::TaskResult result;
+    result.audio_output = std::move(merged_audio);
+    record_generation_metrics(codes, decoder_ms);
+    attach_generation_telemetry(
+        result, codes.generated_codes.frames, codes.generation_cap, codes.termination,
+        prompt_ms, prefill_ms, talker_ms, decoder_ms);
+    debug::timing_log_scalar("qwen3_tts.native_streaming", 1.0);
+    debug::timing_log_scalar("qwen3_tts.stream_blocks", static_cast<double>(emitted_blocks));
+    debug::timing_log_scalar("qwen3_tts.stream_first_block_frames", static_cast<double>(first_block_frames));
+    debug::timing_log_scalar("qwen3_tts.stream_steady_block_frames", static_cast<double>(steady_block_frames));
+    debug::timing_log_scalar("qwen3_tts.stream_left_context_frames", static_cast<double>(left_context_frames));
+    debug::timing_log_scalar("qwen3_tts.voice_prompt_ms", prompt_ms);
+    debug::timing_log_scalar("qwen3_tts.prefill_build_ms", prefill_ms);
+    debug::timing_log_scalar("qwen3_tts.talker_ms", talker_ms);
+    debug::timing_log_scalar("qwen3_tts.speech_decoder_ms", decoder_ms);
+    debug::timing_log_scalar("session.wall_ms", engine::debug::elapsed_ms(wall_start, Clock::now()));
+    return result;
+}
