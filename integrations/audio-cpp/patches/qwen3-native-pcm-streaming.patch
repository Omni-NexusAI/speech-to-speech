+    const runtime::TaskRequest & request,
+    const Qwen3TTSConfig & config) {
+    const auto value = runtime::parse_i64_option(request.options, {kMaxGeneratedFramesOption});
+    if (!value.has_value()) return std::nullopt;
+    // The final autoregressive step is lookahead, so remain below the fixed allocation.
+    if (*value <= 0 || *value >= config.max_new_tokens) {
+        throw std::runtime_error(
+            "qwen3_tts.max_generated_frames must be positive and below the model generation capacity");
+    }
+    if (runtime::find_option(request.options, {"max_tokens"}).has_value()) {
+        throw std::runtime_error("qwen3_tts.max_generated_frames cannot be combined with max_tokens");
+    }
